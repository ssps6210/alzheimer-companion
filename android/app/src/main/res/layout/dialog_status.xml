<?xml version="1.0" encoding="utf-8"?>
<!-- 「系統狀態」對話窗：家人不用另外開瀏覽器分頁查 /health -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/status_emoji"
        android:textSize="36sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/status_title"
        android:textColor="#5A4636"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/status_loading"
        android:textColor="#5A4636"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnCloseStatus"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/dialog_btn_ghost_bg"
        android:text="@string/btn_close"
        android:textColor="#8A5A2B"
        android:textSize="14sp"
        android:stateListAnimator="@null" />

</LinearLayout>
