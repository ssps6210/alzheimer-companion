<?xml version="1.0" encoding="utf-8"?>
<!-- 「輸入電腦網址」對話窗：暖色卡片、大字、好按（配合笑臉阿公圖示） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="🧓"
        android:textSize="44sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/server_title"
        android:textColor="#5A4636"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/server_desc"
        android:textColor="#8A7A66"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/dialog_input_bg"
            android:hint="@string/server_hint"
            android:textColorHint="#C0B199"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="#5A4636"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pasteBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/dialog_btn_ghost_bg"
            android:text="@string/btn_paste"
            android:textSize="18sp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/discoverStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/discover_searching"
        android:textColor="#B0977C"
        android:textSize="12sp" />

    <Button
        android:id="@+id/discoverBtn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dialog_btn_ghost_bg"
        android:text="@string/btn_rediscover"
        android:textColor="#8A5A2B"
        android:textSize="13sp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/scanBtn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dialog_btn_ghost_bg"
        android:text="@string/btn_scan"
        android:textColor="#8A5A2B"
        android:textSize="13sp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/dialog_btn_bg"
        android:text="@string/btn_connect"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
