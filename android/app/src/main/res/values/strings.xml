<?xml version="1.0" encoding="utf-8"?>
<!--
  預設語言：繁體中文。Android 會依裝置語言自動挑：
    values/         繁體中文（預設，找不到其他就用這個）
    values-en/      English
    values-zh-rCN/  简体中文
  加語言＝新增一個 values-<語言代碼>/strings.xml，翻譯裡面的字串即可。
-->
